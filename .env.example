NEXT_PUBLIC_APP_NAME=Riftcore
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development runtime storage. Production persistence is intentionally not
# selected yet; do not point this at a production filesystem.
RIFTCORE_STORAGE_MODE=file
RIFTCORE_RUNTIME_FILE=

# Operator console is local/dev-only until authentication is implemented.
RIFTCORE_ENABLE_UNAUTH_OPS=false

DATABASE_URL=
